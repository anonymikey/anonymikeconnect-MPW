# Shared Node/Express configuration
PORT=3000

# TEST_MODE=true simulates PalPluss STK (development only).
# In production set BOTH of these on Render:
#   TEST_MODE=false
#   PAYMENT_PROVIDER=PALPLUSS
TEST_MODE=true
NODE_ENV=development
PAYMENT_PROVIDER=TEST
CORS_ORIGIN=http://localhost:3000

# Required Postgres/Supabase connection.
# Copy this file to .env and fill with the real Supabase connection string.
# NEVER commit real credentials. Configure the real value only in Render's
# environment settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# PalPluss integration. Placeholders only — set real values in Render env, not here.
PALPLUSS_BASE_URL=https://example-palpluss.test
PALPLUSS_API_KEY=replace-me-with-a-server-only-secret
PALPLUSS_SHORTCODE=000000
PALPLUSS_WEBHOOK_SECRET=replace-me-with-a-webhook-secret-if-configured-by-palpluss

# Public URL PalPluss should call back after payment.
CALLBACK_URL=https://supalan.anonymiketech.space/api/webhooks/palpluss
